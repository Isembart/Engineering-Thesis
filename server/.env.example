DATABASE_URL=sqlite://inzynierka.db?mode=rwc
SERVER_ADDRESS=0.0.0.0:3000
# Required, the server refuses to start without them. Generate each with: openssl rand -base64 32
# ADMIN_TOKEN lets the app rename boards and edit their settings; it is printed with a QR code on startup
ADMIN_TOKEN=
# BOARD_TOKEN goes into every board's provisioning file (board_token)
BOARD_TOKEN=
# Directory with published board firmware, files named <version>.bin (see board/publish.sh)
FIRMWARE_DIR=./firmware
# Optional comma-separated origins; if unset, CORS allows any origin (dev-friendly)
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081